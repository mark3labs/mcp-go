A request declaring a protocol version the server does not implement is
rejected with UnsupportedProtocolVersionError (-32022), whose data names the
versions the server does support so the client can negotiate down (SEP-2575).

-- client --
{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/list",
  "params": {
    "_meta": {
      "io.modelcontextprotocol/protocolVersion": "2099-01-01",
      "io.modelcontextprotocol/clientCapabilities": {}
    }
  }
}
-- server --
{
	"error": {
		"code": -32022,
		"data": {
			"requested": "2099-01-01",
			"supported": [
				"2026-07-28",
				"2025-11-25",
				"2025-06-18",
				"2025-03-26",
				"2024-11-05"
			]
		},
		"message": "unsupported protocol version: \"2099-01-01\" (supported: [2026-07-28 2025-11-25 2025-06-18 2025-03-26 2024-11-05])"
	},
	"id": 1,
	"jsonrpc": "2.0"
}
